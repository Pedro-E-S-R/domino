{
  "name": "@domino/engine",
  "version": "0.0.0",
  "private": true,
  "description": "Pure TypeScript double-six Brazilian domino rules engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist .tsbuildinfo coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.0.0",
    "fast-check": "^3.19.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}

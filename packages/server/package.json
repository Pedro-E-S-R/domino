{
  "name": "@domino/server",
  "version": "0.0.0",
  "private": true,
  "description": "Authoritative server (online + LAN) for Dominó Online",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts --mode=online",
    "dev:lan": "tsx watch src/index.ts --mode=lan",
    "test": "vitest run",
    "clean": "rm -rf dist .tsbuildinfo coverage"
  },
  "dependencies": {
    "@domino/contracts": "*",
    "@domino/engine": "*",
    "express": "^4.19.2",
    "pino": "^9.0.0",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.0",
    "@types/qrcode-terminal": "^0.12.2",
    "pino-pretty": "^11.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
